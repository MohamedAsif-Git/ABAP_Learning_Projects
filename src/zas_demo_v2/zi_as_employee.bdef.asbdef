managed implementation in class zbp_i_as_employee unique;
strict ( 2 );

define behavior for ZI_AS_EMPLOYEE //alias <alias_name>
persistent table zas_employee
lock master
authorization master ( instance )
etag master LastChangedAt
{
  mapping for zas_employee
    {
      EmployeeId    = emp_id;
      EmployeeName  = emp_name;
      Department    = department;
      Designation   = designation;
      Salary        = salary;
      AnnualSalary  = annualsalary;
      Email         = email;
      Phone         = phone;
      JoinDate      = join_date;
      Status        = status;
      CreatedBy     = created_by;
      CreatedAt     = created_at;
      LastChangedBy = last_changed_by;
      LastChangedAt = last_changed_at;
    }
  create;
  update;
  delete;

  determination setCreateAuditFields on modify { create; }
  determination calculateAnnualSalary on modify { field Salary; }

  validation validateEmployee on save { create; update; }

  field ( readonly:update ) EmployeeId;
  field ( readonly )
  AnnualSalary,
  CreatedAt,
  CreatedBy,
  LastChangedAt,
  LastChangedBy;
}